#!/usr/bin/env bash
set -euo pipefail

die() { echo "dispatch-close: $*" >&2; exit 1; }

term=${1:-${HC_TERMINAL_ID:-}}
[[ -n $term ]] || die "not in a herdr terminal (HC_TERMINAL_ID unset)"
info=$(hc get "$term") || die "no terminal $term"
jq -e '.labels["dispatch.agent"] == "1"' >/dev/null <<<"$info" || die "$term is not a dispatch agent pane"

log="$HOME/.local/state/dispatch/close.log"
mkdir -p "${log%/*}"
echo "$(date -Is) close $term $(jq -r '.name // ""' <<<"$info")" >>"$log"

setsid -f bash -c 'sleep 2; hc keep "$0" --off; hc kill "$0"; hc rm "$0"' "$term" >>"$log" 2>&1 </dev/null
echo "dispatch-close: $term closes in 2s"

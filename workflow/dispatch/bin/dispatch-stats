#!/usr/bin/env python3
import argparse, glob, json, os, re, subprocess, sys
from collections import defaultdict
from datetime import datetime

IDLE = 600
PHASES = ("build", "e2e", "review", "manual")


def ts(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def project_prefix():
    try:
        common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        sys.exit("dispatch-stats: run it inside a git repo, or pass --prefix")
    return re.sub(r"[^A-Za-z0-9]", "-", os.path.dirname(common)) + "-"


def kind(name, inp):
    if name == "Bash":
        c = inp.get("command", "")
        if "devbot" in c: return "devbot"
        if "browser-harness" in c or "BU_NAME" in c: return "browser"
        if re.search(r"\bgo (build|vet|test|run)\b", c): return "go"
        return "bash"
    if name in ("Agent", "Task"): return "subagent"
    if name == "AskUserQuestion": return "ask"
    return "other"


def session(path):
    times, uses, results = [], {}, {}
    s = defaultdict(float)
    for line in open(path, errors="ignore"):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") not in ("user", "assistant") or not e.get("timestamp"):
            continue
        t = ts(e["timestamp"])
        times.append(t)
        c = (e.get("message") or {}).get("content")
        if not isinstance(c, list):
            continue
        for b in c:
            if b.get("type") == "tool_result":
                results[b.get("tool_use_id")] = t
            if e["type"] != "assistant" or b.get("type") != "tool_use":
                continue
            inp = b.get("input") or {}
            k = kind(b.get("name", ""), inp)
            uses[b["id"]] = (t, k)
            cmd = inp.get("command", "") if b.get("name") == "Bash" else ""
            if k == "ask": s["questions"] += 1
            if k == "devbot" and "devbot run" in cmd: s["devbot_runs"] += 1
            if b.get("name") in ("Edit", "Write") and "/scratchpad/" not in inp.get("file_path", ""): s["edits"] += 1
            if re.search(r"git commit\b", cmd): s["commits"] += 1
    if not times:
        return None
    times.sort()
    s["start"], s["end"] = times[0], times[-1]
    s["wall"] = times[-1] - times[0]
    s["active"] = sum(min(b - a, IDLE) for a, b in zip(times, times[1:]))
    for i, (t0, k) in uses.items():
        if i in results and k in ("go", "browser", "devbot", "ask"):
            s[k + "_time"] += min(results[i] - t0, 3600)
    return s


def collect(prefix, root):
    tasks = defaultdict(lambda: defaultdict(lambda: defaultdict(float)))
    for d in sorted(os.listdir(root)):
        if not d.startswith(prefix):
            continue
        name, phase = d[len(prefix):], "build"
        for p in ("e2e", "review", "manual"):
            if name.endswith("-" + p):
                name, phase = name[: -len(p) - 1], p
        for f in glob.glob(os.path.join(root, d, "*.jsonl")):
            s = session(f)
            if not s:
                continue
            agg = tasks[name][phase]
            for k, v in s.items():
                if k == "start": agg[k] = min(agg.get(k) or v, v)
                elif k == "end": agg[k] = max(agg.get(k, 0), v)
                else: agg[k] += v
    return tasks


def m(sec):
    return int(sec // 60)


def table(tasks):
    head = ["task", "build", "e2e", "review", "manual", "total", "wall", "go", "browser", "devbot", "runs", "e2e_fixes", "asks", "ask_wait"]
    rows = [head]
    for name, ph in sorted(tasks.items(), key=lambda x: min(p.get("start", 0) for p in x[1].values())):
        all_ = [ph[p] for p in PHASES if p in ph]
        tot = lambda k: sum(p.get(k, 0) for p in all_)
        e2e = ph.get("e2e", {})
        rows.append([name[:32]] + [str(m(ph[p]["active"])) if p in ph else "-" for p in PHASES] + [
            str(m(tot("active"))),
            str(m(max(p["end"] for p in all_) - min(p["start"] for p in all_))),
            str(m(tot("go_time"))), str(m(tot("browser_time"))), str(m(tot("devbot_time"))),
            str(int(tot("devbot_runs"))),
            str(int(e2e.get("edits", 0) + e2e.get("commits", 0))) if e2e else "-",
            str(int(tot("questions"))), str(m(tot("ask_time")))])
    w = [max(len(r[i]) for r in rows) for i in range(len(head))]
    return "\n".join("  ".join(c.ljust(w[i]) for i, c in enumerate(r)) for r in rows)


def markdown(name, ph):
    lines = [f"Time per step for `{name}` (active minutes, idle gaps over {IDLE // 60} min left out):", "",
             "| Step | Active | Go builds | Browser | devbot | Questions to the user |", "|---|---|---|---|---|---|"]
    for p in PHASES:
        if p not in ph:
            continue
        a = ph[p]
        lines.append(f"| {p} | {m(a['active'])} | {m(a.get('go_time', 0))} | {m(a.get('browser_time', 0))} | "
                     f"{m(a.get('devbot_time', 0))} ({int(a.get('devbot_runs', 0))} runs) | "
                     f"{int(a.get('questions', 0))} ({m(a.get('ask_time', 0))} min wait) |")
    return "\n".join(lines)


def main():
    ap = argparse.ArgumentParser(description="Time per dispatch step (build, e2e, review, manual) from the Claude session logs.")
    ap.add_argument("filter", nargs="?", default="", help="only tasks whose name contains this text, e.g. daw-26")
    ap.add_argument("--prefix", help="project folder prefix in ~/.claude/projects (default: from the git repo)")
    ap.add_argument("--md", action="store_true", help="markdown table for one task, for a Linear comment")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    tasks = collect(a.prefix or project_prefix(), os.path.expanduser("~/.claude/projects"))
    tasks = {k: v for k, v in tasks.items() if a.filter in k}
    if not tasks:
        sys.exit(f"dispatch-stats: no task matches {a.filter!r}")
    if a.json:
        print(json.dumps(tasks, indent=1))
    elif a.md:
        if len(tasks) != 1:
            sys.exit(f"dispatch-stats: --md needs one task, {len(tasks)} match: {', '.join(tasks)}")
        print(markdown(*next(iter(tasks.items()))))
    else:
        print(table(tasks))


main()

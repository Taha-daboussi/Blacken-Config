#!/usr/bin/env python3
import argparse, glob, json, os, re, subprocess, sys, time
from collections import OrderedDict, defaultdict
from datetime import datetime

IDLE = 600


def die(msg):
    sys.exit(f"dispatch-stats: {msg}")


def ts(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def main_checkout():
    try:
        common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        die("run it inside a git repo of the task")
    return os.path.dirname(common)


def project_dir(cwd):
    return os.path.join(os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "projects"), re.sub(r"[^A-Za-z0-9]", "-", cwd))


def read_steps(path):
    rows = []
    with open(path) as f:
        for n, line in enumerate(f, 1):
            parts = line.rstrip("\n").split("\t")
            if len(parts) != 4 or not parts[0].isdigit():
                die(f"{path}:{n}: not a steps.tsv line: {line.strip()!r}")
            rows.append((int(parts[0]), parts[1], parts[2], parts[3] == "1"))
    return rows


def scan(path):
    times, browser, uses = [], [], {}
    with open(path, errors="replace") as f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("type") not in ("user", "assistant") or not e.get("timestamp"):
                continue
            t = ts(e["timestamp"])
            times.append(t)
            content = (e.get("message") or {}).get("content")
            if not isinstance(content, list):
                continue
            for b in content:
                if b.get("type") == "tool_use" and b.get("name") == "Bash":
                    cmd = (b.get("input") or {}).get("command", "")
                    if "browser-harness" in cmd or "BU_NAME" in cmd:
                        uses[b.get("id")] = t
                elif b.get("type") == "tool_result" and b.get("tool_use_id") in uses:
                    t0 = uses.pop(b["tool_use_id"])
                    browser.append((t0, min(t - t0, 3600), "browser"))
    return times, browser


def read_events(folder):
    times, spans = [], []
    for path in glob.glob(os.path.join(folder, "*.jsonl")):
        t, br = scan(path)
        times += t
        spans += br
    for path in glob.glob(os.path.join(folder, "*", "subagents", "*.jsonl")):
        t, br = scan(path)
        spans += br
        if t:
            spans.append((min(t), max(t) - min(t), "subagent"))
    times.sort()
    return times, spans


def per_step(rows, times, spans, now):
    out = OrderedDict()
    for i, (t0, n, label, waiting) in enumerate(rows):
        t1 = rows[i + 1][0] if i + 1 < len(rows) else (t0 if label == "closed" else max(now, t0))
        s = out.setdefault(f"{n} {label}", defaultdict(float))
        s["wall"] += t1 - t0
        if waiting:
            s["wait"] += t1 - t0
            continue
        inside = [t for t in times if t0 <= t < t1]
        s["active"] += sum(min(b - a, IDLE) for a, b in zip(inside, inside[1:]))
        for start, dur, k in spans:
            if t0 <= start < t1:
                s[k] += dur
    return out


def task(name, task_dir, main, now):
    steps = os.path.join(task_dir, "steps.tsv")
    if not os.path.isfile(steps):
        return None
    rows = read_steps(steps)
    if not rows:
        return None
    slug = name[len(os.path.basename(main)) + 1:]
    folder = project_dir(f"{main}-{slug}")
    times, spans = read_events(folder) if os.path.isdir(folder) else ([], [])
    return {"steps": per_step(rows, times, spans, now), "log": os.path.isdir(folder),
            "last": f"{rows[-1][1]} {rows[-1][2]}"}


def m(sec):
    return str(int(sec // 60 + 0.5))


def total(t, k):
    return sum(s.get(k, 0) for s in t["steps"].values())


def markdown(name, t):
    lines = [f"Time per step for `{name}` (minutes; active time leaves out gaps over {IDLE // 60} min; parallel sub-agents add up):", "",
             "| Step | Wall | Wait for the user | Active | Sub-agents | Browser |", "|---|---|---|---|---|---|"]
    for step, s in t["steps"].items():
        lines.append(f"| {step} | {m(s['wall'])} | {m(s.get('wait', 0))} | {m(s.get('active', 0))} | "
                     f"{m(s.get('subagent', 0))} | {m(s.get('browser', 0))} |")
    lines.append(f"| total | {m(total(t, 'wall'))} | {m(total(t, 'wait'))} | {m(total(t, 'active'))} | "
                 f"{m(total(t, 'subagent'))} | {m(total(t, 'browser'))} |")
    if not t["log"]:
        lines += ["", "No session log found for this task: active, sub-agent and browser times are 0."]
    return "\n".join(lines)


def table(tasks):
    head = ["task", "last step", "wall", "wait", "active", "subagents", "browser"]
    rows = [head] + [[n[:40], t["last"], m(total(t, "wall")), m(total(t, "wait")), m(total(t, "active")),
                      m(total(t, "subagent")), m(total(t, "browser"))] for n, t in tasks.items()]
    w = [max(len(r[i]) for r in rows) for i in range(len(head))]
    return "\n".join("  ".join(c.ljust(w[i]) for i, c in enumerate(r)) for r in rows)


def main():
    ap = argparse.ArgumentParser(description="Time per pipeline step of dispatch tasks, from steps.tsv in the task "
                                             "folder and the Claude session log of the task pane.")
    ap.add_argument("filter", nargs="?", default="", help="only tasks whose slug contains this text, e.g. daw-26")
    ap.add_argument("--md", action="store_true", help="markdown table for one task, for an issue comment")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    main_dir = main_checkout()
    root = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "dispatch")
    prefix = os.path.basename(main_dir) + "-"
    now = time.time()
    tasks = {}
    for d in sorted(glob.glob(os.path.join(root, prefix + "*")), key=os.path.getmtime):
        name = os.path.basename(d)
        if os.path.isdir(d) and a.filter in name[len(prefix):]:
            t = task(name, d, main_dir, now)
            if t:
                tasks[name] = t
    if not tasks:
        die(f"no task folder with steps.tsv matches {a.filter!r} in {root}")
    if a.json:
        print(json.dumps(tasks, indent=1))
    elif a.md:
        if len(tasks) != 1:
            die(f"--md needs one task, {len(tasks)} match: {', '.join(tasks)}")
        print(markdown(*next(iter(tasks.items()))))
    else:
        print(table(tasks))


main()

#!/usr/bin/env bash
set -euo pipefail

die() { echo "dispatch-close: $*" >&2; exit 1; }

log="${XDG_STATE_HOME:-$HOME/.local/state}/dispatch/close.log"
mkdir -p "${log%/*}"
now=$(date '+%Y-%m-%dT%H:%M:%S%z')

if [[ -n ${DISPATCH_TERM:-} && -z ${1:-} ]]; then
  [[ -n ${TMUX_PANE:-} ]] || die "DISPATCH_TERM is set, but this is not a tmux pane (TMUX_PANE unset)"
  [[ $(tmux show-options -w -t "$TMUX_PANE" -v @dispatch_term 2>/dev/null) == "$DISPATCH_TERM" ]] \
    || die "the tmux window of $TMUX_PANE is not the dispatch pane $DISPATCH_TERM"
  echo "$now close $DISPATCH_TERM" >>"$log"
  tmux run-shell -b "sleep 2; tmux kill-window -t '$TMUX_PANE'"
  echo "dispatch-close: $DISPATCH_TERM closes in 2s"
  exit 0
fi

term=${1:-${HC_TERMINAL_ID:-}}
[[ -n $term ]] || die "not in a dispatch pane (DISPATCH_TERM and HC_TERMINAL_ID unset)"
info=$(hc get "$term") || die "no terminal $term"
jq -e '.labels["dispatch.agent"] == "1"' >/dev/null <<<"$info" || die "$term is not a dispatch agent pane"

echo "$now close $term $(jq -r '.name // ""' <<<"$info")" >>"$log"

closer=(bash -c 'sleep 2; hc keep "$0" --off; hc kill "$0"; hc rm "$0"' "$term")
if command -v setsid >/dev/null; then
  setsid -f "${closer[@]}" >>"$log" 2>&1 </dev/null
elif command -v perl >/dev/null; then
  perl -MPOSIX -e 'fork and exit; POSIX::setsid(); exec @ARGV or die "exec: $!"' "${closer[@]}" >>"$log" 2>&1 </dev/null
else
  die "needs setsid or perl to close $term after this process ends"
fi
echo "dispatch-close: $term closes in 2s"

#!/usr/bin/env bash
set -euo pipefail

if (($# != 2)); then
  cat >&2 <<'EOF'
dispatch-pick-tab <space> <base>: print "<tab id>\t<tab name>" for the next pane of <base> in that herdr space.
It picks the first tab named "<base>" or "<base> N" with fewer than DISPATCH_MAX_PANES (default 4) panes.
When all are full, it prints a new tab id and the first free name ("<base> 2", "<base> 3", ...).
The caller holds the space lock ($XDG_RUNTIME_DIR/dispatch-<space>.lock).
EOF
  exit 2
fi

space=$1 base=$2
max_panes=${DISPATCH_MAX_PANES:-4}

tree=$(herdr-app ls)
jq -e --arg sp "$space" '.spaces[] | select(.id == $sp)' <<<"$tree" >/dev/null || {
  echo "dispatch-pick-tab: space $space is not open in herdr" >&2
  exit 1
}

tab=$(jq -r --arg sp "$space" --arg base "$base" --argjson max "$max_panes" '
  .spaces[] | select(.id == $sp) | .tabs[]
  | select(.name | test("^" + $base + "( [0-9]+)?$"))
  | select((.terminals | length) < $max) | .id' <<<"$tree" | head -n1)

if [[ -z $tab ]]; then
  taken=$(jq -r --arg sp "$space" '.spaces[] | select(.id == $sp) | .tabs[].name' <<<"$tree")
  tab_name=$base
  n=2
  while grep -qxF "$tab_name" <<<"$taken"; do tab_name="$base $n"; n=$((n + 1)); done
  tab=tb$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')
else
  tab_name=$(jq -r --arg sp "$space" --arg tb "$tab" '.spaces[] | select(.id == $sp) | .tabs[] | select(.id == $tb) | .name' <<<"$tree")
fi

printf '%s\t%s\n' "$tab" "$tab_name"

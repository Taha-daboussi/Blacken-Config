#!/usr/bin/env python3
"""Compare the expected screen of one step in expected.md with the DOM text of the shot.

Prints JSON (and writes it to --out): each expected line as exact, space, different or missing,
the extra DOM lines, the row order, and the pixel difference between the before and after shots.
It decides nothing about design: it gives the judge exact facts.
"""
import argparse, difflib, json, os, re, subprocess, sys

MARK = re.compile(r"\s*←\s*changed.*$")


def expected_screen(path, step):
    lines = open(path, encoding="utf-8").read().splitlines()
    in_steps, cur, block = False, None, []
    for ln in lines:
        if re.match(r"^#{2,3}\s+Steps\b", ln):
            in_steps = True
            continue
        if in_steps and re.match(r"^#{1,3}\s", ln):
            break
        if not in_steps:
            continue
        m = re.match(r"^(\d+)\.\s", ln)
        if m:
            if cur == step:
                break
            cur = int(m.group(1))
            continue
        if cur == step:
            block.append(ln)
    if cur != step:
        sys.exit(f"dispatch-ui-diff: step {step} not found under '### Steps' in {path}")
    screen, after_expect = [], False
    for ln in block:
        s = ln.strip()
        if s.lower().startswith("expect:"):
            after_expect = True
            continue
        if after_expect and s:
            changed = bool(MARK.search(s))
            screen.append({"line": MARK.sub("", s).rstrip(), "changed": changed})
    return screen


def norm(s):
    return re.sub(r"\s+", " ", s).strip()


def pixel_diff(before, after, out_dir):
    if not (before and after and os.path.exists(before) and os.path.exists(after)):
        return {"note": "before or after shot missing"}
    try:
        size = lambda p: subprocess.run(["magick", "identify", "-format", "%w %h", p],
                                        capture_output=True, text=True, check=True).stdout.split()
        wb, hb = map(int, size(before))
        wa, ha = map(int, size(after))
        if (wb, hb) != (wa, ha):
            return {"note": f"size differs: before {wb}x{hb}, after {wa}x{ha}"}
        diff_png = os.path.join(out_dir, os.path.splitext(os.path.basename(after))[0] + ".diff.png")
        r = subprocess.run(["magick", "compare", "-metric", "AE", "-fuzz", "2%", before, after, diff_png],
                           capture_output=True, text=True)
        if r.returncode not in (0, 1):
            return {"note": f"magick compare failed: {r.stderr.strip()[:200]}"}
        changed = float(r.stderr.split()[0])
        return {"changed_pixels": int(changed), "share": round(changed / (wa * ha), 4), "diff_image": diff_png}
    except (OSError, subprocess.CalledProcessError, ValueError, IndexError) as e:
        return {"note": f"pixel diff not run: {e}"}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--expected", required=True)
    ap.add_argument("--step", type=int, required=True)
    ap.add_argument("--dom", required=True)
    ap.add_argument("--before")
    ap.add_argument("--after")
    ap.add_argument("--out")
    a = ap.parse_args()

    if a.out:
        os.makedirs(os.path.dirname(a.out) or ".", exist_ok=True)
    screen = expected_screen(a.expected, a.step)
    dom = [l.rstrip() for l in open(a.dom, encoding="utf-8").read().splitlines() if l.strip()]
    used, rows, positions = set(), [], []
    for exp in screen:
        e = exp["line"]
        hit = next((i for i, d in enumerate(dom) if i not in used and d.strip() == e.strip()), None)
        state, seen = "exact", None
        if hit is None:
            hit = next((i for i, d in enumerate(dom) if i not in used and norm(d) == norm(e)), None)
            state = "space" if hit is not None else state
        if hit is None:
            best, score = None, 0.0
            for i, d in enumerate(dom):
                if i in used:
                    continue
                r = difflib.SequenceMatcher(None, norm(e), norm(d)).ratio()
                if r > score:
                    best, score = i, r
            if best is not None and score >= 0.6:
                hit, state = best, "different"
            else:
                state = "missing"
        if hit is not None:
            used.add(hit)
            seen = dom[hit]
            positions.append(hit)
        rows.append({"expected": e, "changed": exp["changed"], "state": state, "seen": seen})

    result = {
        "step": a.step,
        "lines": rows,
        "extra_dom_lines": [d for i, d in enumerate(dom) if i not in used],
        "order_ok": positions == sorted(positions),
        "counts": {k: sum(r["state"] == k for r in rows) for k in ("exact", "space", "different", "missing")},
        "pixels": pixel_diff(a.before, a.after, os.path.dirname(a.out) if a.out else "."),
    }
    if not screen:
        result["note"] = "this step has no expected screen lines"
    text = json.dumps(result, ensure_ascii=False, indent=1)
    if a.out:
        open(a.out, "w", encoding="utf-8").write(text + "\n")
    print(text)


if __name__ == "__main__":
    main()
